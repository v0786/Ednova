 app/android/app/build.gradle            |  40 ++++++++++++++++++++++++
 app/android/ednova-release.keystore     | Bin 2768 -> 0 bytes
 app/android/keystore.properties.example |   6 ++++
 app/scripts/buildAndroidRelease.ts      |  27 ++++++++++++++++
 app/scripts/signAndroidRelease.ts       |  30 ------------------
 docs/ANDROID-SIGNING.md                 |  27 ++++++++++++++++
 11 files changed, 116 insertions(+), 39 deletions(-)
 delete mode 100644 app/EDNOVA-release.aab
 delete mode 100644 app/EDNOVA-release.apk
 delete mode 100644 app/android/ednova-release.keystore
 create mode 100644 app/android/keystore.properties.example
 create mode 100644 app/scripts/buildAndroidRelease.ts
 delete mode 100644 app/scripts/signAndroidRelease.ts
 create mode 100644 docs/ANDROID-SIGNING.md

