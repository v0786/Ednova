diff --git a/app/scripts/buildAndroidRelease.ts b/app/scripts/buildAndroidRelease.ts
new file mode 100644
index 0000000..2e0a6d8
--- /dev/null
+++ b/app/scripts/buildAndroidRelease.ts
@@ -0,0 +1,27 @@
+/**
+ * Builds a release AAB (Play Store) and APK (sideload/testing) with Gradle.
+ * Signing is done by Gradle's signingConfig (v1+v2+v3 signatures, zipaligned) -
+ * credentials come from android/keystore.properties or EDNOVA_* env vars.
+ * This script never creates keys and never contains credentials.
+ */
+import fs from 'fs';
+import path from 'path';
+import { execSync } from 'child_process';
+
+const androidDir = path.resolve(__dirname, '../android');
+const hasProps = fs.existsSync(path.join(androidDir, 'keystore.properties'));
+const hasEnv = Boolean(process.env.EDNOVA_KEYSTORE_PATH);
+
+if (!hasProps && !hasEnv) {
+  console.error(
+    'No signing credentials found.\n' +
+      'Create android/keystore.properties (see keystore.properties.example) or set\n' +
+      'EDNOVA_KEYSTORE_PATH / EDNOVA_KEYSTORE_PASSWORD / EDNOVA_KEY_ALIAS / EDNOVA_KEY_PASSWORD.\n' +
+      'See docs/ANDROID-SIGNING.md.'
+  );
+  process.exit(1);
+}
+
+execSync('./gradlew bundleRelease assembleRelease', { cwd: androidDir, stdio: 'inherit' });
+console.log('\nAAB: android/app/build/outputs/bundle/release/app-release.aab');
+console.log('APK: android/app/build/outputs/apk/release/app-release.apk');
